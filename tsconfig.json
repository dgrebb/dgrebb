// tsconfig.json
{
  "compilerOptions": {
    "target": "ES2024",
    "module": "nodenext",
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "build",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
